<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local workspaces and engine binaries from cloud backup for privacy -->
        <exclude domain="file" path="workspace" />
        <exclude domain="file" path="engine" />
        <exclude domain="file" path="userdata" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="workspace" />
        <exclude domain="file" path="engine" />
        <exclude domain="file" path="userdata" />
    </device-transfer>
</data-extraction-rules>
